# Salin file ini menjadi .env lalu sesuaikan nilainya.

NODE_ENV=development
PORT=3000

# SQLite untuk development. Path relatif terhadap folder api/.
DATABASE_URL="file:./dev.db"
# Contoh PostgreSQL (lihat README bagian "Pindah ke PostgreSQL"):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/belajar_crud"

# Rahasia untuk menandatangani access token (JWT). Minimal 32 karakter.
# Nilai contoh di bawah hanya untuk development; saat NODE_ENV=production server menolak start.
# Buat yang acak: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="ganti-dengan-string-acak-yang-panjang-minimal-32-karakter"

# Origin yang boleh mengakses API. "*" = semua (cocok untuk development).
# Untuk production isi daftar dipisah koma, contoh: https://app.kampus.ac.id,https://admin.kampus.ac.id
CORS_ORIGIN="*"

# Folder penyimpanan file lampiran.
UPLOAD_DIR="uploads"
